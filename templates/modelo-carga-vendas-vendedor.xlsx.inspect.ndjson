{"kind":"table","sheet":"Carga Vendas","address":"A1:J23","rows":23,"cols":10,"values":[["origem","tipo","data","cod_produto","cod_cliente","territorio","quantidade","valor","%MB","cod_vendedor"],["FAT","Máquinas",46176,"0400007","006296","SC",2,184500,0.318,"'000636"],["FAT","Máquinas",46184,"0900012","001523","RS NORTE",5,92000,0.242,"'000672"],["FAT","Máquinas",46197,"0820006","004102","GO_MG SUL",1,92250,null,"'000590"],["CART","Máquinas",46218,"0910037","002190","RS NORTE",1,215000,0.295,""],["FAT","Transgrain",46191,"08203065","004102","PR",1,45000,0.28,"'000673"],["FAT","Acessórios",46200,"101470","001523",null,3,8900,null,""],["FAT","Peças",46193,"99887766","55443322",null,null,12500,null,"'000633"],["CART","Peças",46208,null,null,null,null,4300,null,""],[null,null,null,null,null,null,null,null,null,null],["COMO PREENCHER:",null,null,null,null,null,null,null,null,null],["origem      -> FAT = item já faturado (NF emitida)  |  CART = item em carteira (pedido a faturar)",null,null,null,null,null,null,null,null,null],["tipo        -> OBRIGATÓRIO: Máquinas | Peças | Transgrain | Acessórios. Define o roteamento.",null,null,null,null,null,null,null,null,null],["data        -> FAT = data de emissão da NF  |  CART = data de PREVISÃO de faturamento (competência)",null,null,null,null,null,null,null,null,null],["cod_produto -> código do produto como TEXTO. Precisa existir no cadastro, EXCETO quando tipo=Peças (aí pode ser qualquer código, ou em branco).",null,null,null,null,null,null,null,null,null],["cod_cliente -> código do cliente como TEXTO. Precisa existir no cadastro, EXCETO quando tipo=Peças.",null,null,null,null,null,null,null,null,null],["territorio  -> regional (valida contra o cadastro). OBRIGATÓRIO para Máquinas; em branco para Peças (nacional); opcional para Transgrain/Acessórios.",null,null,null,null,null,null,null,null,null],["quantidade  -> quantidade da linha. Obrigatória, EXCETO Peças (Peças = só valor).",null,null,null,null,null,null,null,null,null],["valor       -> valor em R$ da linha (sempre obrigatório; use negativo para devolução).",null,null,null,null,null,null,null,null,null],["cod_vendedor -> código completo do vendedor como TEXTO (preserve os zeros). OBRIGATÓRIO para FAT e CART.",null,null,null,null,null,null,null,null,null],["%MB         -> margem bruta em % (OPCIONAL; ex: 31,8% = 0,318).",null,null,null,null,null,null,null,null,null],["Peças pulverizadas -> tipo=Peças NÃO exige cadastro de produto/cliente: o sistema usa \"Peças diversas\"/\"Cliente diverso\" e guarda o código digitado. Só olha o VALOR, roteia nacional (Jenifer).",null,null,null,null,null,null,null,null,null],["O sistema DERIVA sozinho (não coloque na planilha): coordenação, responsável, linha de negócio, cultura, cidade/UF. Campanhas usam cod_vendedor + vigência da ATRIBUIÇÃO.",null,null,null,null,null,null,null,null,null]]}
